# ─────────────────────────────────────────────────────────────────────────────
# Family Food Assistant — app configuration (PUBLIC values only).
# Copy to `.env` and fill in. `.env` is git-ignored — never commit it.
# Used at build time:  flutter run --dart-define-from-file=.env
#
# ⚠️ NEVER put these here: OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY.
#    They belong in Supabase Edge Function secrets (see README → Edge Functions).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase → Project Settings → API Keys → "anon public" (legacy) or "publishable" key
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Edge Function that proxies Chef AI (supabase/functions/chef-ai)
AI_FUNCTION_NAME=chef-ai

# Deep link for Google sign-in / password reset on Android & iOS
AUTH_REDIRECT_URL=familyfood://login-callback

# Set to true after enabling Google in Supabase → Authentication → Providers
GOOGLE_SIGN_IN_ENABLED=false
